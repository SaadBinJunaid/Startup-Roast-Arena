# Frontend environment variables
# Copy this file to .env and set your backend API URL.
# Only variables starting with VITE_ are exposed to the browser code.
# This file is ignored by git and must never be committed.

# Local development (default backend)
VITE_API_URL=http://localhost:5000/api

# Production (Vercel): set VITE_API_URL in the Vercel project settings
# (frontend project) to your deployed backend URL, for example:
# VITE_API_URL=https://your-backend.vercel.app/api
# NOTE: Vite inlines this value at BUILD time, so the project must be
# rebuilt (redeploy) after changing it.
