# Copy this file to ".env" and replace the placeholder values with real ones.
# The .env file is ignored by git and must never be committed.

PORT=5000

# MongoDB Atlas connection string (your OWN database, e.g. Smit-Project)
MONGO_URI=your_mongodb_atlas_connection_string

# A long random string used to sign JWT tokens
JWT_SECRET=your_long_random_secret

# Google Gemini API key (needed from Phase 4 onward)
GEMINI_API_KEY=your_gemini_api_key

# Optional: override the Gemini model. Defaults to gemini-3.5-flash.
GEMINI_MODEL=gemini-3.5-flash

# Optional: comma-separated list of frontend origins allowed by CORS.
# Leave it empty (or unset) to allow all origins - fine for local development.
# Production example: CORS_ORIGIN=https://your-frontend.vercel.app
CORS_ORIGIN=

NODE_ENV=development
